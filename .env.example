# Vercel: connected Turso integration supplies these server-only variables.
# Leave blank for local SQLite development. Never prefix with NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local development uses loopback port 3001 and private server-side storage.
ATSAI_DATABASE_PATH=./data/atsai.sqlite

# Leave blank locally to validate against the incoming host.
# Set your exact HTTPS origin on the production server, e.g. https://www.atsai.pro.
ATSAI_ADMIN_ORIGIN=

# Required for FIRST owner signup in production only.
# Generate a random secret of at least 32 characters; never commit it.
ATSAI_ADMIN_SETUP_TOKEN=

# Optional pinned database pair; BOTH override the integration pair together.
# Use for recovery of an existing deployment branch. Server-only.
ATSAI_TURSO_DATABASE_URL=
ATSAI_TURSO_AUTH_TOKEN=

# Optional Google Search Console HTML verification token (not a full meta tag).
# DNS-verified properties do not need this.
GOOGLE_SITE_VERIFICATION=

# Candidate application updates via Resend. Server-only; verify the sender domain first.
RESEND_API_KEY=
ATSAI_EMAIL_FROM=

# Random secret of at least 32 characters for the notification retry worker.
# Schedule GET /api/notifications/dispatch with Authorization: Bearer <secret>.
CRON_SECRET=
