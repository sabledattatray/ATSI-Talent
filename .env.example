# Local development uses loopback port 3001 and private server-side storage.
ATSAI_DATABASE_PATH=./data/atsai.sqlite

# Leave blank locally to validate against the incoming host.
# Set your exact HTTPS origin on the production server, e.g. https://atsai.pro.
ATSAI_ADMIN_ORIGIN=

# Required for FIRST owner signup in production only.
# Generate a random secret of at least 32 characters; never commit it.
ATSAI_ADMIN_SETUP_TOKEN=
